/// Scorecard from the Python analysis: change against no email for every metric and email, 95% intervals, CUPED, and p-values adjusted for six comparisons (Holm).
table Estimates

	column metric
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: metric

	column metric_name
		dataType: string
		summarizeBy: none
		sourceColumn: metric_name

	column role
		dataType: string
		summarizeBy: none
		sourceColumn: role

	column arm
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: arm

	column control_mean
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: control_mean

	column treat_mean
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: treat_mean

	column diff
		dataType: double
		formatString: +0.0000;-0.0000;0
		summarizeBy: none
		sourceColumn: diff

	column rel
		dataType: double
		formatString: +0%;-0%;0%
		summarizeBy: none
		sourceColumn: rel

	column lo
		dataType: double
		formatString: +0.0000;-0.0000;0
		summarizeBy: none
		sourceColumn: lo

	column hi
		dataType: double
		formatString: +0.0000;-0.0000;0
		summarizeBy: none
		sourceColumn: hi

	column p
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: p

	column cuped_diff
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: cuped_diff

	column cuped_lo
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: cuped_lo

	column cuped_hi
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: cuped_hi

	column variance_reduction
		dataType: double
		formatString: 0.00%
		summarizeBy: none
		sourceColumn: variance_reduction

	column p_holm
		dataType: double
		formatString: 0.0E+00
		summarizeBy: none
		sourceColumn: p_holm

	column significant
		dataType: boolean
		summarizeBy: none
		sourceColumn: significant

	partition Estimates = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "estimates.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {{"significant", each if _ = null then null else Text.Lower(_)}}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"metric", type text},
				            {"metric_name", type text},
				            {"role", type text},
				            {"arm", type text},
				            {"control_mean", type number},
				            {"treat_mean", type number},
				            {"diff", type number},
				            {"rel", type number},
				            {"lo", type number},
				            {"hi", type number},
				            {"p", type number},
				            {"cuped_diff", type number},
				            {"cuped_lo", type number},
				            {"cuped_hi", type number},
				            {"variance_reduction", type number},
				            {"p_holm", type number},
				            {"significant", type logical}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

