/// 1,000 fake tests (no email against no email) checked daily for 14 days: how often each p-value raised a false alarm.
table 'AA Test'

	/// Share of fake (no difference) tests that 'found' a winner when the usual p-value was checked daily.
	measure 'False Alarms, Usual p' = MAX ( 'AA Test'[naive_false_alarm] )
		formatString: 0.0%
		displayFolder: Monitoring

	/// The same with the always-valid p-value.
	measure 'False Alarms, Always-Valid p' = MAX ( 'AA Test'[always_valid_false_alarm] )
		formatString: 0.0%
		displayFolder: Monitoring

	column simulations
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: simulations

	column days
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: days

	column naive_false_alarm
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: naive_false_alarm

	column always_valid_false_alarm
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: always_valid_false_alarm

	partition 'AA Test' = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "aa_test.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"simulations", Int64.Type},
				            {"days", Int64.Type},
				            {"naive_false_alarm", type number},
				            {"always_valid_false_alarm", type number}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

