  "measures": [
    {
      "name": "Customers Count",
      "table": "Customers",
      "folder": "Outcomes",
      "format": "#,0",
      "dax": "COUNTROWS ( Customers )",
      "description": "Customers in the current selection."
    },
    {
      "name": "Spend per Customer",
      "table": "Customers",
      "folder": "Outcomes",
      "format": "$#,0.00",
      "dax": "AVERAGE ( Customers[spend] )",
      "description": "Spend in the two weeks after the send, per customer."
    },
    {
      "name": "Purchase Rate",
      "table": "Customers",
      "folder": "Outcomes",
      "format": "0.00%",
      "dax": "AVERAGE ( Customers[conversion] )",
      "description": "Share of customers who bought."
    },
    {
      "name": "Visit Rate",
      "table": "Customers",
      "folder": "Outcomes",
      "format": "0.0%",
      "dax": "AVERAGE ( Customers[visit] )",
      "description": "Share of customers who visited the site."
    },
    {
      "name": "Spend per Customer (No Email)",
      "table": "Customers",
      "folder": "Outcomes",
      "format": "$#,0.00",
      "dax": "CALCULATE ( [Spend per Customer], REMOVEFILTERS ( Arms ), Customers[arm] = \"No E-Mail\" )",
      "description": "The no-email group's spend per customer: the baseline every lift is measured against."
    },
    {
      "name": "Spend Change vs No Email",
      "table": "Customers",
      "folder": "Lift",
      "format": "+$#,0.00;-$#,0.00;$0.00",
      "dax": "[Spend per Customer] - [Spend per Customer (No Email)]",
      "description": "Spend per customer minus the no-email group's (0 for the no-email group itself)."
    },
    {
      "name": "Purchase Rate Change vs No Email",
      "table": "Customers",
      "folder": "Lift",
      "format": "+0.00%;-0.00%;0.00%",
      "dax": "[Purchase Rate] - CALCULATE ( [Purchase Rate], REMOVEFILTERS ( Arms ), Customers[arm] = \"No E-Mail\" )",
      "description": "Purchase rate minus the no-email group's, in percentage points."
    },
    {
      "name": "Men's Email Spend Lift",
      "table": "Customers",
      "folder": "Lift",
      "format": "+$#,0.00;-$#,0.00;$0.00",
      "dax": "CALCULATE ( [Spend per Customer], REMOVEFILTERS ( Arms ), Customers[arm] = \"Mens E-Mail\" ) - [Spend per Customer (No Email)]",
      "description": "Extra spend per customer from the men's email."
    },
    {
      "name": "Men's Email Spend Lift %",
      "table": "Customers",
      "folder": "Lift",
      "format": "+0%;-0%;0%",
      "dax": "DIVIDE ( [Men's Email Spend Lift], [Spend per Customer (No Email)] )",
      "description": "The same as a percentage of the no-email group's spend."
    },
    {
      "name": "Men's vs Women's Email",
      "table": "Customers",
      "folder": "Lift",
      "format": "+$#,0.00;-$#,0.00;$0.00",
      "dax": "CALCULATE ( [Spend per Customer], REMOVEFILTERS ( Arms ), Customers[arm] = \"Mens E-Mail\" ) - CALCULATE ( [Spend per Customer], REMOVEFILTERS ( Arms ), Customers[arm] = \"Womens E-Mail\" )",
      "description": "How much more the men's email earned per customer than the women's."
    },
    {
      "name": "Always-Valid p (Spend)",
      "table": "Sequential",
      "folder": "Monitoring",
      "format": "0.0E+00",
      "dax": "CALCULATE ( MIN ( Sequential[p_always_valid] ), Sequential[metric] = \"spend\" )",
      "description": "Always-valid p-value for spend at each day: safe to check daily; call the test once it is below 0.05."
    },
    {
      "name": "Usual p (Spend)",
      "table": "Sequential",
      "folder": "Monitoring",
      "format": "0.0E+00",
      "dax": "CALCULATE ( MIN ( Sequential[p_naive] ), Sequential[metric] = \"spend\" )",
      "description": "The usual p-value for spend at each day. Checking it daily inflates false alarms."
    },
    {
      "name": "Safe to Call Day",
      "table": "Sequential",
      "folder": "Monitoring",
      "format": "0",
      "dax": "CALCULATE ( MIN ( Sequential[day] ), REMOVEFILTERS ( Arms ), Sequential[arm] = \"Mens E-Mail\", Sequential[metric] = \"spend\", Sequential[p_always_valid] < 0.05 )",
      "description": "First day the men's email spend result could be called with the always-valid p-value."
    },
    {
      "name": "False Alarms, Usual p",
      "table": "AA Test",
      "folder": "Monitoring",
      "format": "0.0%",
      "dax": "MAX ( 'AA Test'[naive_false_alarm] )",
      "description": "Share of fake (no difference) tests that 'found' a winner when the usual p-value was checked daily."
    },
    {
      "name": "False Alarms, Always-Valid p",
      "table": "AA Test",
      "folder": "Monitoring",
      "format": "0.0%",
      "dax": "MAX ( 'AA Test'[always_valid_false_alarm] )",
      "description": "The same with the always-valid p-value."
    },
    {
      "name": "Segment Spend Change",
      "table": "Segments",
      "folder": "Guardrail",
      "format": "+$#,0.00;-$#,0.00;$0.00",
      "dax": "AVERAGE ( Segments[diff] )",
      "description": "Change in spend per customer for a group, against no email."
    },
    {
      "name": "Groups Harmed",
      "table": "Segments",
      "folder": "Guardrail",
      "format": "0",
      "dax": "CALCULATE ( DISTINCTCOUNT ( Segments[level] ), Segments[status] = \"harmed\" ) + 0",
      "description": "Groups where the whole interval is below zero for either email."
    },
    {
      "name": "Groups Too Small to Tell",
      "table": "Segments",
      "folder": "Guardrail",
      "format": "0",
      "dax": "CALCULATE ( DISTINCTCOUNT ( Segments[level] ), Segments[status] = \"too small to tell\" ) + 0",
      "description": "Groups too small to rule out a loss beyond -$1 per customer."
    },
    {
      "name": "Margin Value",
      "table": "Margin",
      "folder": "What-if",
      "format": "0%",
      "dax": "SELECTEDVALUE ( Margin[Margin], 0.35 )",
      "description": "Selected gross margin (35% if none selected)."
    },
    {
      "name": "Email Cost Value",
      "table": "Email Cost",
      "folder": "What-if",
      "format": "$0.000",
      "dax": "SELECTEDVALUE ( 'Email Cost'[Email Cost], 0.02 )",
      "description": "Selected cost per email ($0.02 if none selected)."
    },
    {
      "name": "List Size Value",
      "table": "List Size",
      "folder": "What-if",
      "format": "#,0",
      "dax": "SELECTEDVALUE ( 'List Size'[List Size], 100000 )",
      "description": "Selected list size (100,000 if none selected)."
    },
    {
      "name": "Extra Profit",
      "table": "Policy",
      "folder": "Decision",
      "format": "$#,0",
      "dax": "SUMX ( Policy, ( Policy[lift_vs_nobody] * [Margin Value] - Policy[share_emailed] * [Email Cost Value] ) * [List Size Value] )",
      "description": "Profit on the extra sales minus the cost of the emails, against sending nothing."
    },
    {
      "name": "Best Option",
      "table": "Policy",
      "folder": "Decision",
      "format": null,
      "dax": "VAR scored = ADDCOLUMNS ( ALL ( Policy[policy] ), \"@profit\", [Extra Profit] )\nRETURN MAXX ( TOPN ( 1, scored, [@profit], DESC ), Policy[policy] )",
      "description": "The sending option with the most extra profit at the selected margin, cost and list size."
    },
    {
      "name": "Break-Even Email Cost",
      "table": "Policy",
      "folder": "Decision",
      "format": "$0.000",
      "dax": "VAR men = CALCULATE ( SUM ( Policy[lift_vs_nobody] ), Policy[policy] = \"Men's email to all\" )\nVAR tgt = CALCULATE ( SUM ( Policy[lift_vs_nobody] ), Policy[policy] = \"Targeted (by cell)\" )\nVAR menShare = CALCULATE ( SUM ( Policy[share_emailed] ), Policy[policy] = \"Men's email to all\" )\nVAR tgtShare = CALCULATE ( SUM ( Policy[share_emailed] ), Policy[policy] = \"Targeted (by cell)\" )\nRETURN DIVIDE ( ( men - tgt ) * [Margin Value], menShare - tgtShare )",
      "description": "Email cost above which targeting beats sending the men's email to everyone."
    }
  ],
